{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": ".",
    "runtime": "python311"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.py",
      "**/*.md",
      "**/*.bat",
      "**/*.ps1",
      "**/*.sh",
      "hosting/**",
      "academy/package/**/*.docx",
      "academy/package/**/*.pptx",
      "academy/package/**/*.xlsx",
      "test_*.py",
      "diagnose_*.py",
      "check_*.py",
      "goodbodybucks-firebase-adminsdk-*.json",
      "serviceAccountKey.json",
      "requirements.txt",
      "Dockerfile",
      ".firebase/**",
      ".git/**",
      "agent-tools/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      }
    ]
  }
}
